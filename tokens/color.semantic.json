{
  "bg": {
    "$type": "color",
    "$description": "Backgrounds",
    "default": { "$value": "{sand.100}", "$description": "Page" },
    "sunken": { "$value": "{sand.200}", "$description": "Alternate band" }
  },
  "surface": {
    "$type": "color",
    "$description": "Surfaces that sit on a background",
    "default": { "$value": "{sand.50}", "$description": "Card, note, input" },
    "dark": { "$value": "{cadet.900}", "$description": "Dark section" },
    "dark-raised": { "$value": "{cadet.800}", "$description": "Card on a dark section" }
  },
  "text": {
    "$type": "color",
    "$description": "Text colours",
    "default": { "$value": "{ink.900}" },
    "secondary": { "$value": "{ink.700}" },
    "muted": { "$value": "{ink.500}" },
    "on-dark": { "$value": "{sand.100}" },
    "on-dark-secondary": { "$value": "#B5AE9F", "$description": "7.0:1 on cadet-900" },
    "on-accent": { "$value": "{cadet.950}", "$description": "Text on flame (5.1:1)" }
  },
  "accent": {
    "$type": "color",
    "$description": "Brand accent roles",
    "default": { "$value": "{flame.400}" },
    "hover": { "$value": "{flame.300}" },
    "text": { "$value": "{flame.700}", "$description": "Use when the accent must be read as text on sand" },
    "on-dark": { "$value": "{flame.300}", "$description": "Use when the accent must be read as text on cadet" }
  },
  "line": {
    "$type": "color",
    "$description": "Hairlines and borders",
    "default": { "$value": "rgba(30, 34, 61, 0.13)" },
    "strong": { "$value": "rgba(30, 34, 61, 0.26)" },
    "on-dark": { "$value": "rgba(246, 238, 223, 0.15)" }
  },
  "orbit": {
    "$type": "color",
    "$description": "The thin orbital lines",
    "default": { "$value": "{flame.400}" },
    "on-dark": { "$value": "rgba(246, 238, 223, 0.28)" }
  },
  "focus": {
    "$type": "color",
    "default": { "$value": "{flame.600}", "$description": "Keyboard focus ring" }
  }
}
